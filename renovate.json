{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "config:js-lib",
    "config:react-native"
  ],
  "timezone": "America/New_York",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies", "renovate"],
  "assignees": ["swiftguard-team"],
  "reviewers": ["swiftguard-team"],
  "commitMessagePrefix": "deps:",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "packageRules": [
    {
      "description": "Group React ecosystem updates",
      "groupName": "React Ecosystem",
      "matchPackagePatterns": ["^react", "^@react-native"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group Expo ecosystem updates",
      "groupName": "Expo Ecosystem", 
      "matchPackagePatterns": ["^expo", "^@expo"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group UI component updates",
      "groupName": "UI Components",
      "matchPackagePatterns": ["^@gluestack", "nativewind", "tailwind"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Security updates",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch"],
      "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security", "dependencies"],
        "assignees": ["swiftguard-team"]
      }
    },
    {
      "description": "Major version updates require manual review",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    }
  ],
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    "build/**"
  ],
  "ignoreDeps": [
    "react-native-reanimated"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "assignees": ["swiftguard-team"]
  }
}




