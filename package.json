{
  "name": "swiftguard",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "optimize-assets": "node scripts/optimize-assets.js",
    "analyze-bundle": "node scripts/analyze-bundle.js",
    "optimize-bundle": "node scripts/optimize-bundle.js",
    "optimize-imports": "node scripts/optimize-imports.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "clean": "rm -rf node_modules && npm install",
    "build:analyze": "expo build --clear-cache",
    "update:both": "eas update --branch master --message \"Optimize bundle size and improve performance\"",
    "update:ios": "eas update --branch master --platform ios --message \"iOS update with optimizations\"",
    "update:android": "eas update --branch master --platform android --message \"Android update with optimizations\""
  },
  "dependencies": {
